{
  "name": "jflt-coach",
  "version": "1.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "build:sw": "node scripts/build-sw.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build": "npm run build:worker && npm run build:sw",
    "check": "node scripts/build-worker.mjs --check && node scripts/build-sw.mjs --check && node scripts/check.mjs",
    "deploy:worker": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "playwright": "1.56.0",
    "wrangler": "^4.148.0"
  }
}
